
import java.util.Scanner;

public class Day59 {
    public static void main(String[] args) throws Exception {
        Scanner in= new Scanner(System.in);
        System.out.print("Masukkan N: ");
        int n = in.nextInt();

        System.out.print("Masukkan M: ");
        int m  = in.nextInt();

        for (int i = 1; i <= n; i++) {
            if (i % m == 0) {
                System.out.println(i + " ");
                
            }
            
        }
        in.close();


    
    
    }
}
